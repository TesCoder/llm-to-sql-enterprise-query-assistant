# Copy this file to `.env` and fill in values.
# NOTE: do not commit your real `.env`.

# Database
DATABASE_URL=sqlite+aiosqlite:///./enterprise.db

# LLM fallback (DeepSeek recommended; OpenAI-SDK compatible)
# DeepSeek via OpenAI-style vars (works with this project):
OPENAI_API_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=YOUR_DEEPSEEK_API_KEY

# Optional model overrides
DEEPSEEK_MODEL=deepseek-chat
# OPENAI_MODEL=gpt-4o-mini

